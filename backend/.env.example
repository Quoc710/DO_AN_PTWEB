# =====================================================
# BACKEND ENVIRONMENT CONFIGURATION
# Sao chép file này: cp .env.example .env
# Sau đó điền giá trị thực của bạn vào .env
# =====================================================

# --- Ứng dụng ---
APP_ENV=local
# APP_ENV: local | staging | production
APP_PORT=8000

# --- Cơ sở dữ liệu MySQL ---
DB_HOST=db
# Khi chạy Docker Compose: DB_HOST=db (tên service)
# Khi chạy local thủ công:  DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=QuanLyCuaHangVai
DB_USER=appuser
DB_PASS=secret

# (Dành cho Docker Compose — MySQL root password)
DB_ROOT_PASS=rootsecret

# --- Bảo mật & JWT ---
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_TTL_SECONDS=3600

# --- Session ---
SESSION_NAME=QUANLY_SESS
SESSION_LIFETIME=7200

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# --- Email (SMTP) ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@quanlycuahangvai.local
MAIL_FROM_NAME="Cửa Hàng Vải"

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5500
