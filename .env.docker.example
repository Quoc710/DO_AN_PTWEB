MYSQL_ROOT_PASSWORD=root

# ===== Email SMTP (Gmail) =====
# Không điền mật khẩu Gmail thường. Hãy dùng App Password và đặt trong file
# .env.smtp.local (xem DOCKER.md) để không đưa bí mật vào file mẫu này.
APP_URL=http://localhost:8082
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=AURA MINIMAL

# ===== Cấu hình ngân hàng nhận thanh toán (VietQR) =====
# Điền thông tin tài khoản CỦA CỬA HÀNG (không dùng thông tin mẫu).
# Mã ngân hàng VietQR, ví dụ MB, VCB, TCB, ACB, BIDV...
BANK_ID=
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
# compact2 | compact | qr_only | print
BANK_QR_TEMPLATE=compact2

# Khóa xác thực webhook ngân hàng (gửi qua header X-Webhook-Key, Authorization: Apikey ... hoặc ?key=)
BANK_WEBHOOK_KEY=aura-demo-key
# Cho phép nút "Tôi đã chuyển khoản" xác nhận thủ công (demo). Đặt false khi đã nối webhook thật.
PAYMENT_DEMO_CONFIRM=true
