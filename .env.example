# =====================================================================
# .env.example — Cấu hình toàn dự án (Root Level)
# Dùng cho Docker Compose
#
# Sao chép file này:  cp .env.example .env
# Sau đó điền giá trị thực vào .env (KHÔNG commit .env lên git!)
# =====================================================================

# ── Ứng dụng ─────────────────────────────────────────────────────
APP_ENV=local
# Giá trị: local | staging | production
APP_PORT=8000
# Port expose backend trên máy host: http://localhost:${APP_PORT}

# ── Cơ sở dữ liệu MySQL ──────────────────────────────────────────
DB_NAME=QuanLyCuaHangVai
DB_USER=appuser
DB_PASS=secret
DB_ROOT_PASS=rootsecret
# DB_HOST và DB_PORT được set tự động trong docker-compose (host=db, port=3306)

# ── Bảo mật / JWT ────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_TTL_SECONDS=3600

# ── Session ──────────────────────────────────────────────────────
SESSION_NAME=QUANLY_SESS
SESSION_LIFETIME=7200

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# ── Email SMTP ───────────────────────────────────────────────────
# Dùng Mailtrap (https://mailtrap.io) để test local
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@quanlycuahangvai.local
MAIL_FROM_NAME="Cửa Hàng Vải"

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5500
